
pipeline {
    agent any

    triggers {
        cron('*/5 * * * *')
    }



    environment {
        VENV_DIR = ".venv"
        HOST = "0.0.0.0"
        PORT = "5000"
        APP_MODULE = "app:app"
    }

    stages {
        stage('Setup Virtual Environment') {
            steps {
                sh '''
                    echo "Creating Python virtual environment..."
                    python3 -m venv .venv
                    . .venv/bin/activate

                    echo "Python version:"
                    python --version

                    python -m pip install --upgrade pip
                    python -m pip install -r requirements.txt

                    echo "Setup completed!"
                '''
            }
        }

        
        stage('Run Tests') {
            parallel {
                stage('Test App 1') {
                    steps {
                        sh """
                            . ${VENV_DIR}/bin/activate
                            python -m pytest test_app.py -v
                        """
                    }
                }

                stage('Test App 2') {
                    steps {
                        sh """
                            . ${VENV_DIR}/bin/activate
                            python -m pytest test_app_2.py -v
                        """
                    }
                }
            }
        }


        
        stage('Deploy (Local with Gunicorn)') {
            steps {
                echo 'Starting Flask app locally using Gunicorn...'
                sh """#!/bin/bash
                    . ${VENV_DIR}/bin/activate

                    rm -f gunicorn.pid

                    JENKINS_NODE_COOKIE=dontKillMe nohup gunicorn \
                        --bind ${HOST}:${PORT} ${APP_MODULE} \
                        --pid gunicorn.pid \
                        > gunicorn.log 2>&1 < /dev/null &

                    sleep 3

                    if [ -f gunicorn.pid ] && kill -0 \$(cat gunicorn.pid) 2>/dev/null; then
                        echo "Gunicorn is running successfully!"
                    else
                        echo "Gunicorn failed to start:"
                        cat gunicorn.log
                        exit 1
                    fi
                """
            }
        }

    }
}
